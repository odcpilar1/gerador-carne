<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Carnês - Clínica Odontológica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>

    <div class="logo">
        <!-- Substitua pelo caminho da sua logo -->
        <img src="logo.png" alt="Logo da Clínica">
    </div>

    <div class="titulo">
        <h1>Gerador de Carnês</h1>
        <h2>Clínica Odontológica</h2>
    </div>

</header>

<main>

<section class="formulario">

<h3>Dados do Paciente</h3>

<div class="campo">
<label>Nome</label>
<input type="text" id="nome">
</div>

<div class="campo">
<label>CPF</label>
<input type="text" id="cpf">
</div>

<div class="campo">
<label>Telefone</label>
<input type="text" id="telefone">
</div>

<h3>Tratamento</h3>

<div class="campo">
<label>Procedimento</label>
<input type="text" id="procedimento">
</div>

<div class="campo">
<label>Valor Total</label>
<input type="number" id="valorTotal">
</div>

<div class="campo">
<label>Entrada</label>
<input type="number" id="entrada" value="0">
</div>

<div class="campo">
<label>Quantidade de Parcelas</label>
<input type="number" id="parcelas">
</div>

<div class="campo">
<label>Primeiro Vencimento</label>
<input type="date" id="primeiroVencimento">
</div>

<div class="botoes">

<button id="gerar">
Gerar Carnê
</button>

<button id="imprimir">
Imprimir
</button>

<button id="pdf">
Baixar PDF
</button>

<button id="limpar">
Limpar
</button>

</div>

</section>

<section class="preview">

<h2>Pré-visualização do Carnê</h2>

<div id="carnes">

<!-- Os carnês aparecerão aqui -->

</div>

</section>

</main>

<script src="script.js"></script>

</body>
</html>
/* ===========================
   GERADOR DE CARNÊS
   Clínica Odontológica
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#F4F7F4;
    color:#333;
}

/* CABEÇALHO */

header{
    background:#2E7D32;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:20px;
    padding:20px;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
}

.logo img{
    width:80px;
}

.titulo h1{
    font-size:30px;
    font-weight:700;
}

.titulo h2{
    color:#D4AF37;
    font-size:18px;
    font-weight:500;
}

/* CONTEÚDO */

main{
    max-width:1300px;
    margin:30px auto;
    display:grid;
    grid-template-columns:380px 1fr;
    gap:25px;
    padding:20px;
}

/* FORMULÁRIO */

.formulario{

    background:white;

    border-radius:15px;

    padding:25px;

    box-shadow:0 5px 15px rgba(0,0,0,.08);

}

.formulario h3{

    color:#2E7D32;

    margin-bottom:15px;

    margin-top:20px;

    border-left:5px solid #D4AF37;

    padding-left:10px;

}

.campo{

    display:flex;

    flex-direction:column;

    margin-bottom:15px;

}

label{

    margin-bottom:5px;

    font-size:14px;

    font-weight:600;

}

input{

    padding:12px;

    border:1px solid #CCC;

    border-radius:8px;

    font-size:15px;

}

input:focus{

    outline:none;

    border-color:#2E7D32;

}

/* BOTÕES */

.botoes{

    display:grid;

    gap:10px;

    margin-top:25px;

}

button{

    padding:13px;

    border:none;

    border-radius:8px;

    font-size:15px;

    cursor:pointer;

    transition:.3s;

}

#gerar{

    background:#2E7D32;

    color:white;

}

#gerar:hover{

    background:#256728;

}

#imprimir{

    background:#D4AF37;

    color:white;

}

#imprimir:hover{

    background:#b8941e;

}

#pdf{

    background:#1565C0;

    color:white;

}

#limpar{

    background:#777;

    color:white;

}

/* PREVIEW */

.preview{

    background:white;

    border-radius:15px;

    padding:25px;

    box-shadow:0 5px 15px rgba(0,0,0,.08);

}

.preview h2{

    color:#2E7D32;

    margin-bottom:20px;

}

/* MODELO DO CARNÊ */

.carne{

    display:grid;

    grid-template-columns:1fr 1fr;

    border:2px solid #2E7D32;

    margin-bottom:25px;

}

.via{

    padding:15px;

    border-right:1px dashed #999;

}

.via:last-child{

    border-right:none;

}

.topoCarne{

    display:flex;

    align-items:center;

    gap:10px;

    border-bottom:2px solid #D4AF37;

    padding-bottom:10px;

    margin-bottom:10px;

}

.topoCarne img{

    width:45px;

}

.nomeClinica{

    color:#2E7D32;

    font-size:18px;

    font-weight:700;

}

.info{

    margin:6px 0;

    font-size:14px;

}

.assinatura{

    margin-top:35px;

    border-top:1px solid #555;

    text-align:center;

    padding-top:5px;

    font-size:13px;

}

/* IMPRESSÃO */

@media print{

body{

background:white;

}

.formulario{

display:none;

}

main{

display:block;

}

.preview{

box-shadow:none;

padding:0;

}

button{

display:none;

}

}
